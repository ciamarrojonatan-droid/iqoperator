# Conta IQOption — FORWARD TEST EM DEMO
IQ_EMAIL=seu_email@gmail.com
IQ_PASSWORD=sua_senha
# PRACTICE = demo (obrigatório p/ forward test). REAL exige CONFIRM_REAL=YES.
IQ_BALANCE_TYPE=PRACTICE
CONFIRM_REAL=

# Ativos — multi-ativo (30 ativos suportados: Forex, Crypto e Metais)
# O bot resolve automaticamente OTC nos finais de semana e mercado normal nos dias úteis.
IQ_ASSET=EURUSD
IQ_ASSETS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURGBP,EURJPY,GBPJPY,AUDJPY,EURAUD,EURCAD,EURNZD,EURCHF,GBPAUD,GBPCAD,GBPCHF,GBPNZD,AUDCAD,AUDNZD,AUDCHF,CADJPY,CHFJPY,CADCHF,NZDJPY,NZDCAD,BTCUSD,ETHUSD,XAUUSD
# Trava global: no máximo N posições pendentes simultâneas (manual bypassa)
IQ_MAX_CONCURRENT=5
IQ_TIMEFRAME=60
IQ_EXPIRATION=1
IQ_CANDLE_COUNT=120
HTF_TIMEFRAME=3600
HTF_COUNT=100
HTF_EMA=50

# Valor fixo (só se USE_KELLY=0)
IQ_AMOUNT=2.0
# Trava na faixa validada no backtest 1y (payout >= 0.80)
IQ_PAYOUT_MIN=0.80

# Gerenciamento sessão
IQ_STOP_WIN=50.0
IQ_STOP_LOSS=30.0
IQ_MAX_MARTINGALE=0
IQ_MARTINGALE_MULTIPLIER=2.0

# Kelly validado no backtest 1y
USE_KELLY=1
KELLY_PRIOR=0.58
KELLY_FRACTION=0.25
KELLY_MAX_RISK=0.02
KELLY_MIN=1.0
KELLY_LOOKBACK=50
KELLY_PRIOR_WEIGHT=20.0
KELLY_PAYOUT_DEFAULT=0.87

# Estratégia do forward test: donchian_fade (validada IS+OOS+ano fresco)
# Para operar a estratégia probabilística MHI 1 em M1:
# STRATEGY=mhi_1 | IQ_TIMEFRAME=60 | IQ_EXPIRATION=1 | IQ_MHI_TREND_EMA=100 | IQ_MHI_REQUIRE_TREND=1
STRATEGY=mhi_1
ML_THRESHOLD=0.58
IQ_MHI_TREND_EMA=100
IQ_MHI_REQUIRE_TREND=0
DONCHIAN_N=20
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
# 0 = zona (modo do backtest vencedor), 1 = só saída
RSI_REQUIRE_EXIT=0
EMA_FAST=9
EMA_SLOW=21

# Logs (no Railway, montar um Volume em /app/data p/ persistir)
# Sem volume: use HF bucket (HF_TOKEN + HF_DATASET_REPO) — ver abaixo
LOG_FILE=data/bot.log
TRADE_LOG=data/trades_live.csv

# Bucket HF opcional (Railway sem disco): espelha trades_live.csv no dataset
# Crie o dataset em hf.co/new-dataset (ex: jonatanciamarro/iqoperator-trades)
# HF_TOKEN=hf_xxx  (Settings -> Access Tokens, role Write)
# HF_DATASET_REPO=jonatanciamarro/iqoperator-trades
HF_TOKEN=
HF_DATASET_REPO=jonatanciamarro/iqoperator-trades
